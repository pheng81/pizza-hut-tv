[Unit]
Description=Pizza Hut TV Flask (gunicorn)
After=network.target
StartLimitIntervalSec=500
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/pizza-hut-tv
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/pizza-hut-tv/.venv/bin/python -m gunicorn -w 3 -b 127.0.0.1:5002 app:app
Restart=always
RestartSec=5
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
