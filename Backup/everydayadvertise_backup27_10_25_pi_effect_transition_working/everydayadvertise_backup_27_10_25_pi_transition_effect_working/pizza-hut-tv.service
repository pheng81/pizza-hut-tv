[Unit]
Description=Pizza Hut TV - Gunicorn with WebSocket Support
After=network.target

[Service]
Environment="GOOGLE_CLIENT_SECRET=REDACTED"
Environment="GOOGLE_CLIENT_ID=REDACTED"
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/pizza-hut-tv
Environment=PYTHONUNBUFFERED=1
Environment=FLASK_ENV=production
ExecStart=/var/www/pizza-hut-tv/venv/bin/gunicorn --worker-class eventlet --workers 1 --bind 127.0.0.1:5002 --timeout 600 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
