<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- Pressed state (DPAD center long press) -->
	<item android:state_pressed="true">
		<shape android:shape="rectangle">
			<corners android:radius="32dp" />
			<solid android:color="#3357FF" />
			<stroke android:width="3dp" android:color="#66A3FF" />
		</shape>
	</item>

	<!-- Focused & selected (both) -->
	<item android:state_focused="true" android:state_selected="true">
		<shape android:shape="rectangle">
			<corners android:radius="32dp" />
			<solid android:color="#1E3A5A" />
			<stroke android:width="4dp" android:color="#4FC3F7" />
		</shape>
	</item>

	<!-- Focused only -->
	<item android:state_focused="true">
		<shape android:shape="rectangle">
			<corners android:radius="32dp" />
			<solid android:color="#263544" />
			<stroke android:width="3dp" android:color="#3E92CC" />
		</shape>
	</item>

	<!-- Selected only (not currently focused) -->
	<item android:state_selected="true">
		<shape android:shape="rectangle">
			<corners android:radius="32dp" />
			<solid android:color="#1B2A38" />
			<stroke android:width="3dp" android:color="#4FC3F7" />
		</shape>
	</item>

	<!-- Default -->
	<item>
		<shape android:shape="rectangle">
			<corners android:radius="32dp" />
			<solid android:color="#1A232C" />
			<stroke android:width="2dp" android:color="#2E3E4A" />
		</shape>
	</item>
</selector>
