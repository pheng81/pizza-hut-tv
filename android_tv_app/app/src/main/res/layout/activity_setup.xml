<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#0d1117"
	android:fillViewport="true">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:padding="20dp"
		android:gravity="center">



		<!-- Two Column Layout: QR Code Left, Form Right -->
		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="center">

			<!-- Left Column: QR Code -->
			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:gravity="center"
				android:layout_marginEnd="16dp">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="📱 Scan with your phone to enter code"
					android:textColor="#9aa4b2"
					android:textSize="11sp"
					android:layout_marginBottom="8dp" />

				<ImageView
					android:id="@+id/qrCodeImageView"
					android:layout_width="240dp"
					android:layout_height="240dp"
					android:background="@android:color/transparent"
					android:padding="0dp"
					android:scaleType="fitCenter" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Code entered on phone will appear here automatically"
					android:textColor="#9aa4b2"
					android:textSize="10sp"
					android:gravity="center"
					android:layout_marginTop="6dp" />
			</LinearLayout>

			<!-- Vertical Divider Line -->
			<View
				android:layout_width="2dp"
				android:layout_height="match_parent"
				android:background="#444444"
				android:layout_marginStart="16dp"
				android:layout_marginEnd="16dp" />

			<!-- Right Column: Form -->
			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:gravity="center">

				<!-- Moved title and subtitle here to align with QR -->
				<TextView
					android:id="@+id/appTitle"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Enter your Android TV pairing code"
					android:textColor="#FFFFFF"
					android:textSize="22sp"
					android:textStyle="bold"
					android:layout_marginBottom="4dp" />

				<TextView
					android:id="@+id/prompt"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Type the 4-digit code from your TV app or profile page."
					android:textColor="#9aa4b2"
					android:textSize="13sp"
					android:layout_marginBottom="10dp" />

				<EditText
					android:id="@+id/editTextPairCode"
					android:layout_width="336dp"
					android:layout_height="wrap_content"
					android:inputType="number"
					android:imeOptions="actionDone"
					android:textColor="#E6EDF3"
					android:textColorHint="#6b7785"
					android:hint="4-digit code (e.g. 1126)"
					android:background="@drawable/input_field_background"
					android:padding="13dp"
					android:textSize="18sp"
					android:letterSpacing="0.25"
					android:gravity="center" />

				<Button
					android:id="@+id/buttonVerifyCode"
					android:layout_width="336dp"
					android:layout_height="wrap_content"
					android:text="Link Code"
					android:textAllCaps="false"
					android:layout_marginTop="12dp"
					android:background="@drawable/link_code_button_background"
					android:textColor="#ffffff"
					android:textSize="15sp"
					android:padding="13dp" />

				<TextView
					android:id="@+id/codeStatusText"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textColor="#9aa4b2"
					android:layout_marginTop="12dp"
					android:textSize="16sp" />
			</LinearLayout>
		</LinearLayout>

	<!-- Only pairing step content on this screen -->

	</LinearLayout>
</ScrollView>
