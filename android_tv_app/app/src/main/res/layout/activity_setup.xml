<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#000000">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="24dp"
		android:gravity="center_horizontal">

		<TextView
			android:id="@+id/appTitle"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Store Face"
			android:textColor="#FFFFFF"
			android:textSize="28sp"
			android:padding="8dp" />

		<TextView
			android:id="@+id/prompt"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Enter your store number"
			android:textColor="#FFFFFF"
			android:textSize="18sp"
			android:paddingTop="8dp" />

		<EditText
			android:id="@+id/editTextStoreId"
			android:layout_width="600dp"
			android:layout_height="wrap_content"
			android:inputType="number"
			android:imeOptions="actionDone"
			android:textColor="#000000"
			android:textColorHint="#666666"
			android:hint="e.g. 1881"
			android:background="#FFFFFF"
			android:padding="12dp"
			android:layout_marginTop="12dp"
			android:layout_gravity="center_horizontal" />

		<Button
			android:id="@+id/buttonFetchScreens"
			android:layout_width="600dp"
			android:layout_height="wrap_content"
			android:text="Show Available Screens"
			android:textAllCaps="false"
			android:layout_marginTop="12dp"
			android:layout_gravity="center_horizontal" />

		<TextView
			android:id="@+id/statusText"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="#DDDDDD"
			android:layout_marginTop="16dp" />

		<LinearLayout
			android:id="@+id/screensContainer"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:layout_marginTop="16dp" />

	</LinearLayout>
</ScrollView>
