<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#0d1117"
	android:fillViewport="true">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:padding="28dp"
		android:gravity="center">

		<TextView
			android:id="@+id/appTitle"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Enter your Android TV pairing code"
			android:textColor="#FFFFFF"
			android:textSize="26sp"
			android:textStyle="bold"
			android:gravity="center"
			android:layout_marginBottom="6dp" />

		<TextView
			android:id="@+id/prompt"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Scan the QR code or type the 4-digit code from your phone."
			android:textColor="#9aa4b2"
			android:textSize="14sp"
			android:gravity="center"
			android:layout_marginBottom="24dp" />

		<!-- Two matched step cards, top-aligned so their headers always line
			 up regardless of which column has more content. -->
		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="top|center_horizontal">

			<!-- Step 1: QR code -->
			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:gravity="center_horizontal"
				android:background="@drawable/pair_step_card_background"
				android:padding="22dp"
				android:layout_marginEnd="18dp">

				<LinearLayout
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="horizontal"
					android:gravity="center_vertical"
					android:layout_gravity="start"
					android:layout_marginBottom="16dp">

					<TextView
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:text="1"
						android:textColor="#75a7ff"
						android:textSize="12sp"
						android:textStyle="bold"
						android:gravity="center"
						android:background="@drawable/pair_step_number_background" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="SCAN OR SEND CODE"
						android:textColor="#E6EDF3"
						android:textSize="13sp"
						android:textStyle="bold"
						android:letterSpacing="0.05"
						android:layout_marginStart="10dp" />
				</LinearLayout>

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="TV / Web Player code"
					android:textColor="#9fc1ff"
					android:textSize="13sp"
					android:textStyle="bold"
					android:gravity="center"
					android:layout_marginBottom="6dp" />

				<TextView
					android:id="@+id/tvPairCodeValue"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="------"
					android:textColor="#FFFFFF"
					android:textSize="18sp"
					android:textStyle="bold"
					android:letterSpacing="0.14"
					android:gravity="center"
					android:background="@drawable/tv_pair_code_background"
					android:paddingLeft="12dp"
					android:paddingRight="12dp"
					android:paddingTop="8dp"
					android:paddingBottom="8dp"
					android:layout_marginBottom="16dp" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="📱 Scan with your phone to enter code"
					android:textColor="#9aa4b2"
					android:textSize="11sp"
					android:layout_marginBottom="8dp" />

				<ImageView
					android:id="@+id/qrCodeImageView"
					android:layout_width="220dp"
					android:layout_height="220dp"
					android:background="@android:color/transparent"
					android:padding="0dp"
					android:scaleType="fitCenter" />

				<TextView
					android:layout_width="200dp"
					android:layout_height="wrap_content"
					android:text="Code entered on phone will appear here automatically"
					android:textColor="#9aa4b2"
					android:textSize="10sp"
					android:gravity="center"
					android:layout_marginTop="10dp" />
			</LinearLayout>

			<!-- Step 2: enter code -->
			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:gravity="center_horizontal"
				android:background="@drawable/pair_step_card_background"
				android:padding="22dp">

				<LinearLayout
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="horizontal"
					android:gravity="center_vertical"
					android:layout_gravity="start"
					android:layout_marginBottom="16dp">

					<TextView
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:text="2"
						android:textColor="#75a7ff"
						android:textSize="12sp"
						android:textStyle="bold"
						android:gravity="center"
						android:background="@drawable/pair_step_number_background" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="ENTER CODE HERE"
						android:textColor="#E6EDF3"
						android:textSize="13sp"
						android:textStyle="bold"
						android:letterSpacing="0.05"
						android:layout_marginStart="10dp" />
				</LinearLayout>

				<EditText
					android:id="@+id/editTextPairCode"
					android:layout_width="300dp"
					android:layout_height="wrap_content"
					android:inputType="number"
					android:imeOptions="actionDone"
					android:textColor="#E6EDF3"
					android:textColorHint="#6b7785"
					android:hint="4-digit code"
					android:background="@drawable/input_field_background"
					android:padding="13dp"
					android:textSize="18sp"
					android:letterSpacing="0.25"
					android:gravity="center" />

				<Button
					android:id="@+id/buttonVerifyCode"
					android:layout_width="300dp"
					android:layout_height="wrap_content"
					android:text="Link Code"
					android:textAllCaps="false"
					android:layout_marginTop="12dp"
					android:background="@drawable/link_code_button_background"
					android:textColor="#ffffff"
					android:textSize="15sp"
					android:padding="13dp" />

				<TextView
					android:id="@+id/codeStatusText"
					android:layout_width="300dp"
					android:layout_height="wrap_content"
					android:textColor="#9aa4b2"
					android:gravity="center"
					android:layout_marginTop="12dp"
					android:textSize="14sp" />
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>
</ScrollView>
