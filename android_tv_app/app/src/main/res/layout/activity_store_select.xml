<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d1117"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <Button
            android:id="@+id/buttonChangeCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change pairing code"
            android:textAllCaps="false"
            android:textColor="#8fb3ff"
            android:background="@android:color/transparent"
            android:layout_gravity="start"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_marginBottom="24dp" />

        <!-- Side by side layout: QR code left, form right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <!-- Left side: QR Code -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 Scan to enter store code"
                    android:textColor="#9da7b3"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <ImageView
                    android:id="@+id/qrCodeStoreImageView"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="QR code for store entry" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan with your phone"
                    android:textColor="#6b7785"
                    android:textSize="11sp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- Vertical divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#30ffffff"
                android:layout_marginEnd="24dp" />

            <!-- Right side: Form -->
            <LinearLayout
                android:id="@+id/card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enter store code"
                    android:textColor="#e6edf3"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TV code: —"
                    android:textColor="#8fb3ff"
                    android:textSize="13sp"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:id="@+id/storeCodeLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Store code"
                    android:textColor="#9da7b3"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/editTextStoreId"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/input_field_background"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="#e6edf3"
                    android:textColorHint="#6b7785"
                    android:hint="Enter store code"
                    android:inputType="number"
                    android:letterSpacing="0.03"
                    android:maxLines="1"
                    android:imeOptions="actionDone"
                    android:layout_marginBottom="18dp"
                    android:nextFocusDown="@id/buttonFetchScreens" />

                <Button
                    android:id="@+id/buttonFetchScreens"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Show Available Screens"
                    android:textAllCaps="false"
                    android:textColor="#ffffff"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusUp="@id/editTextStoreId"
                    android:nextFocusDown="@id/screensContainer" />

                <TextView
                    android:id="@+id/helpText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="You'll choose a screen next"
                    android:textColor="#9da7b3"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#DDDDDD"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/screensContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal" />

    </LinearLayout>
</ScrollView>
