<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- This is the color when the button is SELECTED (focused) -->
    <!-- We are changing it from red to BLUE -->
    <item android:state_focused="true"
        android:drawable="@android:color/holo_blue_dark" />

    <!-- This is the color when the button is being PRESSED -->
    <item android:state_pressed="true"
        android:drawable="@android:color/holo_blue_dark" />

    <!-- This is the default color when nothing is selected -->
    <item android:drawable="@android:color/darker_gray" />

</selector>