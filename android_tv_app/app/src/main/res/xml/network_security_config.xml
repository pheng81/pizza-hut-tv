<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
	<!-- Release default: disallow cleartext; HTTPS only -->
	<base-config cleartextTrafficPermitted="false">
		<trust-anchors>
			<certificates src="system" />
			<certificates src="user" />
		</trust-anchors>
	</base-config>
</network-security-config>
