<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

	<application
		android:allowBackup="true"
		android:label="@string/app_name"
		android:icon="@mipmap/ic_launcher"
		android:roundIcon="@mipmap/ic_launcher_round"
		android:supportsRtl="true"
		android:networkSecurityConfig="@xml/network_security_config"
		android:theme="@style/Theme.PizzaHutTV">
		<activity android:name=".SetupActivity" android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
				<category android:name="android.intent.category.LEANBACK_LAUNCHER" />
			</intent-filter>
		</activity>
		<activity android:name=".TvDisplayActivity" android:exported="false" />
		<activity android:name=".ChangeScreenActivity" android:exported="false" />
	</application>

</manifest>
