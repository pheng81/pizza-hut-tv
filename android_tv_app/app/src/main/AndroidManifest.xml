<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Android TV support (optional, allows phones too) -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
	<uses-feature android:name="android.hardware.faketouch" android:required="false" />

	<application
		android:allowBackup="true"
		android:label="@string/app_name"
		android:icon="@drawable/app_icon_512"
		android:roundIcon="@drawable/app_icon_512"
		android:banner="@drawable/tv_banner"
		android:supportsRtl="true"
		android:networkSecurityConfig="@xml/network_security_config"
		android:theme="@style/Theme.EverydayAdvertiseTV">
		<activity 
			android:name=".SetupActivity" 
			android:exported="true"
			android:screenOrientation="landscape"
			android:configChanges="orientation|screenSize|keyboardHidden">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
				<category android:name="android.intent.category.LEANBACK_LAUNCHER" />
			</intent-filter>
		</activity>
		<activity 
			android:name=".TvDisplayActivity" 
			android:exported="false"
			android:screenOrientation="landscape"
			android:configChanges="orientation|screenSize|keyboardHidden" />
		<activity 
			android:name=".ChangeScreenActivity" 
			android:exported="false"
			android:screenOrientation="landscape"
			android:configChanges="orientation|screenSize|keyboardHidden" />
		<activity 
			android:name=".StoreSelectActivity" 
			android:exported="false"
			android:screenOrientation="landscape"
			android:configChanges="orientation|screenSize|keyboardHidden" />
	</application>

</manifest>
