[Unit]
Description=PizzaHutTV Screen1 (Primary) Player
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=everydayadvertise
WorkingDirectory=/home/everydayadvertise/pizza-hut-tv
ExecStart=/usr/bin/python3 /home/everydayadvertise/pizza-hut-tv/enterprise_launcher.py --store {{STORE_CODE}} --screen 1 --code {{PAIR_CODE}}
Restart=on-failure
RestartSec=6
Environment=PHTV_SERVER_URL=https://everydayadvertise.com
# Force embedded python player (primary) even if sync group later flips temporarily
Environment=ENABLE_VLC_SLICE_CROP=0

[Install]
WantedBy=multi-user.target
