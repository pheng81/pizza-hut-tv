[Unit]
Description=EverydayAdvertise Flask (Gunicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/pizza-hut-tv
Environment=PYTHONUNBUFFERED=1
Environment=MEDIA_BASE_URL=https://api.everydayadvertise.com
ExecStart=/home/ubuntu/pizza-hut-tv/.venv/bin/gunicorn -c deploy/gunicorn.conf.py app:app
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
