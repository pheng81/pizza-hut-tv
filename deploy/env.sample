# Copy to /etc/pizza-hut-tv.env and adjust values
# This will be loaded by systemd override for everydayadvertise.service

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# In dev, you can omit ADMIN_PASSWORD and set DEV_DEFAULT_PASSWORD=admin
# DEV_DEFAULT_PASSWORD=admin

# Cookie scope across subdomains
SESSION_COOKIE_DOMAIN=.everydayadvertise.com

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Restrict Google logins to a domain (optional)
# GOOGLE_ALLOWED_DOMAIN=yourcompany.com

# Microsoft OAuth (optional)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Control who can sign in:
# - common      -> allows work/school AND personal Microsoft accounts (recommended if you want "anyone")
# - organizations -> only work/school (Azure AD) accounts
# - consumers   -> only personal Microsoft accounts
# - <tenant GUID> -> restrict to a single Azure AD tenant
# If unset, the app defaults to 'common'.
# Example to allow anyone:
# MICROSOFT_TENANT_ID=common
MICROSOFT_TENANT_ID=
# Notes:
# - In Azure App Registration, create a Client secret and use the Secret VALUE (not the secret ID).
# - Add redirect URI: https://api.everydayadvertise.com/auth/microsoft/callback and enable "ID tokens".
# - Put exactly one MICROSOFT_CLIENT_ID and one MICROSOFT_CLIENT_SECRET in /etc/pizza-hut-tv.env.
#   Avoid duplicates; systemd uses the last value if repeated, which can override your real values.
# - Ensure /etc/pizza-hut-tv.env uses Unix LF line endings (no CRLF), or variables may be ignored.
# - If a secret is exposed anywhere, rotate it in Azure and update the env file immediately.

# Media base (prefer CDN/custom domain)
MEDIA_BASE_URL=https://cdn.everydayadvertise.com

# R2 / S3-compatible storage
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# SMTP for emails (password reset, verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional explicit From address (e.g., no-reply@everydayadvertise.com)
SMTP_FROM=
SMTP_USE_TLS=true
# Optional: timeout in seconds for SMTP operations (connect/login/send)
SMTP_TIMEOUT=12

# Notes:
# - Do NOT wrap values in quotes. Example: SMTP_PASSWORD=mySecret123 (not "mySecret123").
# - For Microsoft 365, ensure Authenticated SMTP is enabled for the mailbox and organization.
# - Host: smtp.office365.com, Port: 587, TLS: true.
