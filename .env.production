# Production Environment Configuration
# AWS Lightsail Server

FLASK_ENV=production
FLASK_DEBUG=False

# Database
DATABASE_PATH=/var/www/pizza-hut-tv/database.db

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=5002

# Logging
LOG_LEVEL=INFO

# Feature Flags
ENABLE_DEBUG_ROUTES=False
ENABLE_MOCK_DATA=False

# URLs
BASE_URL=https://everydayadvertise.com
