# Vonage SMS Configuration (for phone verification)
# Get these from: https://dashboard.nexmo.com/
VONAGE_API_KEY=your_api_key_here
VONAGE_API_SECRET=your_api_secret_here
VONAGE_FROM_NUMBER=+13165308999

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_DISPLAY=$1 per screen / month
SUBSCRIPTION_PRICE_PER_SCREEN=1
STRIPE_TRIAL_DAYS=14

# Native mobile subscriptions (the mobile product ID must match both stores)
APPLE_IAP_SHARED_SECRET=app_store_connect_shared_secret_here
APPLE_IAP_PRODUCT_ID=screens_monthly
APPLE_IAP_BUNDLE_ID=com.everydayadvertise.everydayMobile
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=/etc/everydayadvertise/google-play-service-account.json
GOOGLE_PLAY_PACKAGE_NAME=com.everydayadvertise.everyday_mobile
GOOGLE_PLAY_PRODUCT_ID=screens_monthly

# Database
USERS_DB_PATH=./database.db

# Flask Secret
SECRET_KEY=your-secret-key-here

# Google Drive / Picker
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_PICKER_API_KEY=your_google_picker_api_key_here
GOOGLE_CLOUD_PROJECT_NUMBER=your_google_cloud_project_number_here

# Sign in with Apple
# Team ID U6SKM3QX29 / Key ID S8BN744L7P (see DEVELOPMENT_GUIDE.md)
# Web Service ID - the aud claim for the browser sign-in flow
APPLE_CLIENT_ID=com.everydayadvertise.web
# iOS bundle ID - the aud claim for the native sign-in flow
APPLE_IOS_CLIENT_ID=com.everydayadvertise.everydayMobile
# Comma-separated bundle IDs accepted for native sign-in
APPLE_NATIVE_CLIENT_IDS=com.everydayadvertise.everydayMobile
# Leave blank to allow any email domain
APPLE_ALLOWED_DOMAIN=
# NEVER commit the real value. ES256 JWT generated from AuthKey_S8BN744L7P.p8,
# max 6 month lifetime - regenerate before it expires.
APPLE_CLIENT_SECRET=generated_apple_jwt_here
