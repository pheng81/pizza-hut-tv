# Copy this file to .env and fill in values (do NOT commit .env)

# Cloudflare R2 S3-compatible endpoint (account-level, no bucket suffix)
R2_ENDPOINT_URL=https://e0e697ba93f5fde654340ebc4206b59c.r2.cloudflarestorage.com

# Your R2 bucket name
R2_BUCKET_NAME=everydayadvertise

# Paste the Access Key ID and Secret Access Key you generated under R2 → S3 API Tokens → (your token) → Create access key
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public CDN base URL for serving media (your R2 Custom Domain)
MEDIA_BASE_URL=https://cdn.everydayadvertise.com

# Optional: Protects the /admin/migrate_to_r2 endpoint
MIGRATE_SECRET=
R2_BUCKET_NAME=everydayadvertise
R2_ENDPOINT_URL=https://e0e697ba93f5fde654340ebc4206b59c.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
MEDIA_BASE_URL=https://cdn.everydayadvertise.com/

# Fallback (local)
# MEDIA_BASE_URL=/static/uploads/
